Question5 <- function(country) {
wars <- assignment1 %>%
filter(Country == country)
x <- mean(wars$BattleDeaths, na.rm = TRUE)
if (is.na(x)) {
cat("No battle death data available for", country, "\n")
} else {
cat(country, "'s wars had on average ", round(x, 1), " battle deaths\n", sep = "")
}
}
