Mean_Country_BattleDeaths <- function(data, variable, condition, country) {
data_subset <- data[condition, ]
group_mean <- mean(data_subset[[variable]], na.rm = TRUE)
return(paste(country, "’s wars had on average",
round(group_mean, 2), "battle deaths"))
}
