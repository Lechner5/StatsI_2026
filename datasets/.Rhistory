BD_Average <- function(death, nation) {
death_filtered <- filter(!grepl(0, BattleDeaths))
# removing data that is missing
death_filtered <- death[!is.na(death$BattleDeaths), ]
nation_data <- death_filtered[death_filtered$Country == nation,]
## paste(field)$BattleDeaths[deathBattleDeaths == NA] <-
## field <- death[paste(field),]
mean(nation_data$BattleDeaths)
print (paste(nation, "has had an average of", mean(nation_data$BattleDeaths) , "deaths from batte" ))
}
