# load libraries
# set wd
# clear global .envir
#####################
# remove objects
rm(list=ls())
# detach all libraries
detachAllPackages <- function() {
basic.packages <- c("package:stats", "package:graphics", "package:grDevices", "package:utils", "package:datasets", "package:methods", "package:base")
package.list <- search()[ifelse(unlist(gregexpr("package:", search()))==1, TRUE, FALSE)]
package.list <- setdiff(package.list, basic.packages)
if (length(package.list)>0)  for (package in package.list) detach(package,  character.only=TRUE)
}
detachAllPackages()
# load libraries
pkgTest <- function(pkg){
new.pkg <- pkg[!(pkg %in% installed.packages()[,  "Package"])]
if (length(new.pkg))
install.packages(new.pkg,  dependencies = TRUE)
sapply(pkg,  require,  character.only = TRUE)
}
# here is where you load any necessary packages
# ex: stringr
# lapply(c("stringr"),  pkgTest)
lapply("tidyverse", pkgTest)
# set wd for current folder
setwd(dirname(rstudioapi::getActiveDocumentContext()$path))
# read in data
inc_sub <- read.csv("https://raw.githubusercontent.com/ASDS-TCD/StatsI_2026/main/datasets/incumbents_subset.csv")
### Question 1 ###
# We are interested in knowing how the difference in campaign spending between incumbent
# and challenger affects the incumbent’s vote share.
# 1. Run a regression where the outcome variable is voteshare and the explanatory variable
# is difflog.
model1 <- lm(voteshare ~ difflog, data = inc_sub)
summary(model1)
# 2. Make a scatterplot of the two variables and add the regression line
plot1 <- ggplot2::ggplot(data = inc_sub,
aes(x = difflog,
y = voteshare)) +
geom_point(alpha = 0.5) +
# Looked it up in StackOverflow
geom_smooth(method='lm') +
# Theme
theme_minimal() +
# Labels
labs(title = "Campaign Spending and Vote Share",
x = "Difference in Campaign Spending (log)",
y = "Vote Share")
ggplot2::ggsave("plot1.pdf",
plot1,
units = "in",
width = 7,
height = 5)
# 3. Save the residuals of the model in a separate object
errors_model1 <- model1$residuals
summary(errors_model1)
# 4. Write the prediction equation.
# votesharehat = alpha + difflog*ß1
# If we wanted to use R:
# yhat <- model1$coefficients[1] + model1$coefficients[2]*inc_sub$difflog
# For the concrete Values, see Part 1 of the question
##### Question 2 ###
# We are interested in knowing how the difference between incumbent and challenger’s spending
# and the vote share of the presidential candidate of the incumbent’s party are related.
# 1. Run a regression where the outcome variable is presvote and the explanatory variable
# is difflog
model2 <- lm(presvote ~ difflog, data = inc_sub)
summary(model2)
# 2. Make a scatterplot of the two variables and add the regression line.
plot2 <- ggplot2::ggplot(data = inc_sub,
aes(x = difflog,
y = presvote)) +
geom_point() +
geom_smooth(method = "lm")
ggplot2::ggsave("plot2.pdf",
plot2,
units = "in",
width = 7,
height = 5)
# 3. Save the residuals of the model in a separate object.
errors_model2 <- model2$residuals
# 4. Write the prediction equation.
# Yhat = alpha + difflog*ß1
yhat2 <- model2$coefficients[1] + model2$coefficients[2]*inc_sub$difflog
### Question 3 ###
# We are interested in knowing how the vote share of the presidential candidate of the
# incumbent’s party is associated with the incumbent’s electoral success.
# 1. Run a regression where the outcome variable is voteshare and the explanatory variable
# is presvote.
model3 <- lm(voteshare ~ presvote, data = inc_sub)
summary(model3)
# 2. Make a scatterplot of the two variables and add the regression line
plot3 <- ggplot2::ggplot(data = inc_sub,
aes(x = presvote,
y = voteshare)) +
# Use Alpha to visually distinguish between the points
geom_point(alpha = 0.5) +
geom_smooth(method = "lm") +
# Theme
theme_minimal() +
# Labels
labs(title = "Presidental Votes and Vote Share",
x = "Presidental Votes",
y = "Vote Share")
ggplot2::ggsave("plot3.pdf",
plot3,
units = "in",
width = 7,
height = 5)
# 3. Write the prediction equation.
# votesharehat = alpha + presvote*ß1
# If we want to use R to calculate predictions for every case:
# yhat3 <- model3$coefficients[1] + model3$coefficients[2] * inc_sub$presvote
# For the concrete Values, see Part 1 of the question
# Question 4
# The residuals from part (a) tell us how much of the variation in voteshare is not explained
# by the difference in spending between incumbent and challenger. The residuals in part (b)
# tell us how much of the variation in presvote is not explained by the difference in spending
# between incumbent and challenger in the district
# 1. Run a regression where the outcome variable is the residuals from Question 1 and the
# explanatory variable is the residuals from Question 2.
error_data <- data.frame(errors_model1, errors_model2)
model4 <- lm(errors_model1 ~ errors_model2, data = error_data)
summary(model4)
# 2. Make a scatterplot of the two residuals and add the regression line.
ggplot4 <- ggplot2::ggplot(data = error_data,
aes(y = errors_model1,
x = errors_model2)) +
# Use alpha to distinguish the points visually
geom_point(alpha = 0.5) +
geom_smooth(method = "lm")
# Theme
theme_minimal() +
# Labels
labs(title = "Residual Regression",
x = "Residual Model 2 (Presvote ~ difflog)",
y = "Residual Model 1 (Voteshare ~ difflog)")
ggplot2::ggsave("plot4.pdf",
plot4,
units = "in",
width = 7,
height = 5)
model2 <- lm(presvote ~ difflog, data = inc_sub)
summary(model2)
plot2 <- ggplot2::ggplot(data = inc_sub,
aes(x = difflog,
y = presvote)) +
geom_point(alpha = 0.5) +
geom_smooth(method = "lm") +
# Theme
theme_minimal() +
# Labels
labs(title = "Campaign Spending and Vote Share",
x = "Difference in Campaign Spending (log)",
y = "Vote Share")
ggplot2::ggsave("plot2.pdf",
plot2,
units = "in",
width = 7,
height = 5)
# 2. Make a scatterplot of the two variables and add the regression line.
plot2 <- ggplot2::ggplot(data = inc_sub,
aes(x = difflog,
y = presvote)) +
geom_point(alpha = 0.5) +
geom_smooth(method = "lm") +
# Theme
theme_minimal() +
# Labels
labs(title = "Campaign Spending and Presidental Candidates Success",
x = "Difference in Campaign Spending (log)",
y = "Vote Share Presidental Candidate")
ggplot2::ggsave("plot2.pdf",
plot2,
units = "in",
width = 7,
height = 5)
model3 <- lm(voteshare ~ presvote, data = inc_sub)
summary(model3)
ggplot2::ggplot(data = inc_sub,
aes(x = presvote,
y = voteshare)) +
# Use Alpha to visually distinguish between the points
geom_point(alpha = 0.5) +
geom_smooth(method = "lm") +
# Theme
theme_minimal() +
# Labels
labs(title = "Presidental Votes and Vote Share",
x = "Presidental Votes",
y = "Vote Share")
# Remove objects
rm(list=ls())
# Detach all libraries
detachAllPackages <- function() {
basic.packages <- c("package:stats", "package:graphics", "package:grDevices", "package:utils", "package:datasets", "package:methods", "package:base")
package.list <- search()[ifelse(unlist(gregexpr("package:", search()))==1, TRUE, FALSE)]
package.list <- setdiff(package.list, basic.packages)
if (length(package.list)>0)  for (package in package.list) detach(package,  character.only=TRUE)
}
detachAllPackages()
# Load libraries
pkgTest <- function(pkg){
new.pkg <- pkg[!(pkg %in% installed.packages()[,  "Package"])]
if (length(new.pkg))
install.packages(new.pkg,  dependencies = TRUE)
sapply(pkg,  require,  character.only = TRUE)
}
# Load any necessary packages
lapply(c("stargazer", "vioplot", "arm"),  pkgTest)
# Set working directory for current folder
setwd(dirname(rstudioapi::getActiveDocumentContext()$path))
df <- read.csv("../../datasets/ESS10.csv")
df_IRE <- df[df$cntry=="IE", c("euftf","edlvdie","eduyrs","hinctnta","trstplt",
"imwbcnt","gndr","agea","brncntr")]
View(df_IRE)
# Reverse euftf to measure euroscepticism more intuitively
df_IRE["euftf_re"] = 10 - df_IRE[ ,c("euftf")]
# -----------------------------------------------------------
# Categorize the education level
# -----------------------------------------------------------
# Create an empty variable
df_IRE["edu_cat"] <- NA
# Junior Cycle: values 1-4
df_IRE[(df_IRE$edlvdie==1) | (df_IRE$edlvdie==2) | (df_IRE$edlvdie==3) | (df_IRE$edlvdie==4), c("edu_cat")] <- 1
# Leaving Certificate: values 5-9
df_IRE[(df_IRE$edlvdie==5) | (df_IRE$edlvdie==6) | (df_IRE$edlvdie==7) | (df_IRE$edlvdie==8) | (df_IRE$edlvdie==9), c("edu_cat")] <- 2
# Advanced Certificate: values 10-12
df_IRE[(df_IRE$edlvdie==10) | (df_IRE$edlvdie==11) | (df_IRE$edlvdie==12), c("edu_cat")] <- 3
# Bachelor Degree: values 13-15
df_IRE[(df_IRE$edlvdie==13) | (df_IRE$edlvdie==14) | (df_IRE$edlvdie==15), c("edu_cat")] <- 4
# Postgraduate Degree: values 16-18
df_IRE[(df_IRE$edlvdie==16) | (df_IRE$edlvdie==17) | (df_IRE$edlvdie==18), c("edu_cat")] <- 5
# Convert into factor variable
df_IRE$edu_cat <- factor(df_IRE$edu_cat,
levels = c(1,2,3,4,5),
labels = c("Junior Cycle",
"Leaving Certificate",
"Advanced Certificate",
"Bachelor Degree",
"Postgraduate Degree"))
levels(df_IRE$edu_cat)
typeof(df_IRE$edu_cat)
# Convert into factor variable
df_IRE$edu_cat <- factor(df_IRE$edu_cat,
levels = c(1,2,3,4,5),
labels = c("Junior Cycle",
"Leaving Certificate",
"Advanced Certificate",
"Bachelor Degree",
"Postgraduate Degree"))
levels(df_IRE$edu_cat)
typeof(df_IRE$edu_cat)
# Record missing values
df_IRE[(df_IRE == -67) | (df_IRE == -78) | (df_IRE == -89) | (df_IRE == 77) | (df_IRE == 88) |
(df_IRE == 99) | (df_IRE == 5555) | (df_IRE == 7777) | (df_IRE == 8888) | (df_IRE == 9999)] <- NA
# -----------------------------------------------------------
# Descriptive Plots
# -----------------------------------------------------------
# Violin plot: European unification attitudes by education category
vioplot(df_IRE$euftf_re ~ df_IRE$edu_cat)
# Remove objects
rm(list=ls())
# Detach all libraries
detachAllPackages <- function() {
basic.packages <- c("package:stats", "package:graphics", "package:grDevices", "package:utils", "package:datasets", "package:methods", "package:base")
package.list <- search()[ifelse(unlist(gregexpr("package:", search()))==1, TRUE, FALSE)]
package.list <- setdiff(package.list, basic.packages)
if (length(package.list)>0)  for (package in package.list) detach(package,  character.only=TRUE)
}
detachAllPackages()
# Load libraries
pkgTest <- function(pkg){
new.pkg <- pkg[!(pkg %in% installed.packages()[,  "Package"])]
if (length(new.pkg))
install.packages(new.pkg,  dependencies = TRUE)
sapply(pkg,  require,  character.only = TRUE)
}
# Load any necessary packages
lapply(c("stargazer", "vioplot", "arm"),  pkgTest)
# Set working directory for current folder
setwd(dirname(rstudioapi::getActiveDocumentContext()$path))
# Research questions:
# What is the relationship between education and Euroscepticism?
# Subsetting data
# Look at the codebook:
# -----------------------------------------------------------
# Dependent Variable (DV)
# -----------------------------------------------------------
# euftf: European unification — should it go further or has it gone too far?
# Scale: 0 = Unification has gone too far | 10 = Unification should go further
# -----------------------------------------------------------
# Independent Variables (IV)
# -----------------------------------------------------------
# edlvdie: Highest level of education (Ireland-specific)
# eduyrs: Years of full-time education completed
# -----------------------------------------------------------
# Control Variables
# -----------------------------------------------------------
# Z1 - hinctnta: Household total net income (all sources)
#       Unit: Deciles (1 = lowest income, 10 = highest income)
#
# Z2 - trstplt: Trust in politicians
#       Scale: 0 = No trust at all | 10 = Complete trust
#
# Z3 - imwbcnt: Immigrants make the country a worse or better place to live
#       Scale: 0 = Worse place | 10 = Better place
# -----------------------------------------------------------
# Socio-Demographic Controls
# -----------------------------------------------------------
# gndr: Gender (1 = Male | 2 = Female)
# agea: Age of respondent (in years)
# brncntr: Born in country (1 = Yes | 2 = No)
# Only include Ireland and relevant variables.
df <- read.csv("../../datasets/ESS10.csv")
df_IRE <- df[df$cntry=="IE", c("euftf","edlvdie","eduyrs","hinctnta","trstplt",
"imwbcnt","gndr","agea","brncntr")]
View(df_IRE)
# Reverse euftf to measure euroscepticism more intuitively
df_IRE["euftf_re"] = 10 - df_IRE[ ,c("euftf")]
# -----------------------------------------------------------
# Categorize the education level
# -----------------------------------------------------------
# Create an empty variable
df_IRE["edu_cat"] <- NA
# Junior Cycle: values 1-4
df_IRE[(df_IRE$edlvdie==1) | (df_IRE$edlvdie==2) | (df_IRE$edlvdie==3) | (df_IRE$edlvdie==4), c("edu_cat")] <- 1
# Leaving Certificate: values 5-9
df_IRE[(df_IRE$edlvdie==5) | (df_IRE$edlvdie==6) | (df_IRE$edlvdie==7) | (df_IRE$edlvdie==8) | (df_IRE$edlvdie==9), c("edu_cat")] <- 2
# Advanced Certificate: values 10-12
df_IRE[(df_IRE$edlvdie==10) | (df_IRE$edlvdie==11) | (df_IRE$edlvdie==12), c("edu_cat")] <- 3
# Bachelor Degree: values 13-15
df_IRE[(df_IRE$edlvdie==13) | (df_IRE$edlvdie==14) | (df_IRE$edlvdie==15), c("edu_cat")] <- 4
# Postgraduate Degree: values 16-18
df_IRE[(df_IRE$edlvdie==16) | (df_IRE$edlvdie==17) | (df_IRE$edlvdie==18), c("edu_cat")] <- 5
# Convert into factor variable
df_IRE$edu_cat <- factor(df_IRE$edu_cat,
levels = c(1,2,3,4,5),
labels = c("Junior Cycle",
"Leaving Certificate",
"Advanced Certificate",
"Bachelor Degree",
"Postgraduate Degree"))
levels(df_IRE$edu_cat)
typeof(df_IRE$edu_cat)
# Record missing values
df_IRE[(df_IRE == -67) | (df_IRE == -78) | (df_IRE == -89) | (df_IRE == 77) | (df_IRE == 88) |
(df_IRE == 99) | (df_IRE == 5555) | (df_IRE == 7777) | (df_IRE == 8888) | (df_IRE == 9999)] <- NA
# -----------------------------------------------------------
# Descriptive Plots
# -----------------------------------------------------------
# Violin plot: European unification attitudes by education category
vioplot(df_IRE$euftf_re ~ df_IRE$edu_cat)
# Scatter plot: Relationship between education level and EU attitude
plot(df_IRE$edlvdie, df_IRE$euftf_re)
# -----------------------------------------------------------
# Descriptive Plots
# -----------------------------------------------------------
# Violin plot: European unification attitudes by education category
vioplot(df_IRE$euftf_re ~ df_IRE$edu_cat)
# Scatter plot: Relationship between education level and EU attitude
plot(df_IRE$edlvdie, df_IRE$euftf_re)
# Jittered scatter plot: Adds noise to reduce overlap of points
plot(jitter(df_IRE$edlvdie, 2), jitter(df_IRE$euftf_re, 2))
# -----------------------------------------------------------
# Simple model: socio-demographic variables only
# -----------------------------------------------------------
model_base <- lm(euftf_re ~ edlvdie + gndr + agea + brncntr, data = df_IRE)
summary(model_base)
